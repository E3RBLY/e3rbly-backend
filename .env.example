# Copy to .env for local development. Never commit .env.
# In Vercel, set these in Project Settings -> Environment Variables.

# --- Auth for /api/* ---
# strict (default): requires a Firebase ID token with a verified email
# optional: open access; a valid token still identifies the user
AUTH_MODE=strict

# Firebase Admin service account JSON (raw JSON or base64). Required when AUTH_MODE=strict.
# Local dev can instead use firebase-service-account-key.json in the repo root (git-ignored).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- AI provider (Gemini REST) ---
# Required for all AI endpoints
GOOGLE_GENAI_API_KEY=
# Model code; change without a code change. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# Per-attempt timeout (ms), retries on 429/5xx/timeouts, and output cap
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=8192

# --- Fallback AI provider (Groq, OpenAI-compatible) ---
# Optional. When set, Gemini failures (quota, outage, bad key, bad JSON) switch to Groq.
GROQ_API_KEY=
# See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# How long (ms) a provider that hit quota/auth/outage is skipped.
# 0 = Gemini first on every request; Groq only answers when Gemini fails.
AI_FALLBACK_COOLDOWN_MS=0
# Whole-request AI budget across providers and retries (the app gives up at 60s)
AI_TOTAL_BUDGET_MS=45000

# --- Response cache (i'rab, analysis, grammar explanation/related; per instance) ---
# 0 disables
AI_CACHE_MAX_ENTRIES=500
AI_CACHE_TTL_MS=86400000

# Local server port (Vercel ignores this)
PORT=3001

# --- Abuse / cost limits ---
# Requests per IP per minute (per server instance). 0 disables.
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_AI_PER_MIN=10
# Max characters for arabicText and similar fields; max JSON body size
MAX_TEXT_CHARS=1000
MAX_BODY_SIZE=16kb
