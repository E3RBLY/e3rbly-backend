# Copy to .env for local development. Never commit .env.
# In Vercel, set these in Project Settings -> Environment Variables.

# --- Auth for /api/* ---
# strict (default): requires a Firebase ID token with a verified email
# optional: open access; a valid token still identifies the user
AUTH_MODE=strict

# Firebase Admin service account JSON (raw JSON or base64). Required when AUTH_MODE=strict.
# Local dev can instead use firebase-service-account-key.json in the repo root (git-ignored).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- AI provider (Gemini REST) ---
# Required for all AI endpoints
GOOGLE_GENAI_API_KEY=
# Model code; change without a code change. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# Per-attempt timeout (ms), retries on 429/5xx/timeouts, and output cap
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=4096

# Local server port (Vercel ignores this)
PORT=3001
