# Copy to .env for local development. Never commit .env.
# In Vercel, set these in Project Settings -> Environment Variables.

# Google Gemini API key (required for all AI endpoints)
GOOGLE_GENAI_API_KEY=

# strict | optional   (strict requires a valid token on /api/*)
AUTH_MODE=strict

# Required when AUTH_MODE=strict or when /auth routes are used. Long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase web config used by /auth/login
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Redirect after email verification
VERIFICATION_REDIRECT_URL=

# Local server port (Vercel ignores this)
PORT=3001

# NOTE: the Firebase Admin service account is currently read from a file
# (firebase-service-account-key.json, git-ignored). Phase 2 moves it to an env var.
